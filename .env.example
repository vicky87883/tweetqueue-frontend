# Copy to .env.local for development. Add the same values in your production host.

# Public app URL, no trailing slash.
PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=/api/backend

# Hostinger MySQL / phpMyAdmin database.
# Use mysql://USER:PASSWORD@HOST:3306/DATABASE
DATABASE_URL=mysql://u678781700_tweetqueue:YOUR_DATABASE_PASSWORD@localhost:3306/u678781700_tweetqueue

# Auth and encryption. Use long random secrets in production.
JWT_SECRET=replace-with-a-long-random-secret
ENCRYPTION_KEY=replace-with-another-long-random-secret
JWT_EXPIRES_IN=7d
BCRYPT_ROUNDS=12

# Email verification. For Hostinger email, use your mailbox SMTP settings.
MAIL_REQUIRE_VERIFICATION=true
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@your-domain.com
SMTP_PASS=your-email-password
MAIL_FROM="TweetQueue <no-reply@your-domain.com>"

# Admin console at /admin/login.
ADMIN_EMAIL=admin@your-domain.com
ADMIN_PASSWORD=replace-with-a-strong-password
# Recommended instead of ADMIN_PASSWORD when ready:
# ADMIN_PASSWORD_HASH=
CONTENT_ADMIN_SECRET=replace-with-a-long-random-secret

# X / Twitter OAuth and publishing.
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=https://your-domain.com/api/backend/api/x/callback
X_AUTHORIZE_ORIGIN=https://x.com
X_API_BASE_URL=https://api.x.com

# Scheduled publishing trigger. Call POST /api/backend/api/scheduled-posts/publish-due with Authorization: Bearer this-value.
CRON_SECRET=replace-with-a-long-random-secret

# Server-only Groq API key for the /ai page. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# xschedular public trial settings. Server-only.
XSCHEDULAR_TRIAL_LIMIT=4
XSCHEDULAR_TRIAL_SECRET=replace-with-a-long-random-secret
XSCHEDULAR_HOST=xschedular.tweetqueue.com
