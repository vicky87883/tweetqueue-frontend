# Copy to .env.local for development. Set these in Vercel → Environment Variables for Production / Preview.

# Browser calls this same-origin Next proxy; the proxy forwards to Render server-side.
NEXT_PUBLIC_API_URL=/api/backend

# Deployed Express API (no trailing slash). Required in Vercel.
BACKEND_API_URL=https://tweetqueue-1.onrender.com

# Server-only Groq API key for the /ai page. Never prefix this with NEXT_PUBLIC_.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# xschedular public trial settings. Server-only.
XSCHEDULAR_TRIAL_LIMIT=4
XSCHEDULAR_TRIAL_SECRET=replace-with-a-long-random-secret
XSCHEDULAR_HOST=xschedular.tweetqueue.com
